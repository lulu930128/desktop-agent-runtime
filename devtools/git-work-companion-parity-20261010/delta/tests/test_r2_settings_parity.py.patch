+        with patch("kuro_launcher.qt_app.QMessageBox.question", return_value=QMessageBox.StandardButton.Yes):
+            self.w._delete_selected_memory()
+        self.fx.tasks.call_args.args[1]()
+        self.c.delete_memory.assert_called_once_with("id-1", expected_conf_uid="role-a", expected_digest="review-digest")
+
