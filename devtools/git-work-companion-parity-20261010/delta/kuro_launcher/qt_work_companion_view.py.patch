+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.setObjectName("HistoryDrawer")
+        self.records = []
+        self.active_uid = ""
+        self.ready = False
+        self.pending = False
+        self.error = ""
+        layout = QVBoxLayout(self)
+        layout.setContentsMargins(20, 20, 20, 16)
+        heading = QHBoxLayout()
