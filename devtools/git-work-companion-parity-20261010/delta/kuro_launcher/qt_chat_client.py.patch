+    def _history_request(self, operation: str, **values) -> bool:
+        if not self.history_ready:
+            self.error_occurred.emit("對話紀錄尚未就緒；需要支援 history.v1 的 Conversation Runtime。")
+            return False
+        if self.history_pending:
