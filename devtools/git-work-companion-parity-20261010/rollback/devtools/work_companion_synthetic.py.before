"""Anonymous, deterministic fixtures and an in-memory-only preview model.

Never imported by a production entrypoint. No settings, history, clocks, files,
network, command execution or service discovery are used.
"""
from __future__ import annotations

from PySide6.QtCore import QObject, QTimer

