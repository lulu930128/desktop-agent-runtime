class SyntheticPreviewModel(QObject):
    """Disposable preview state. One cancellable, bounded Qt timer; no IO."""

    def __init__(self, view: WorkCompanionView, *, reply_delay_ms: int = 1200):
        super().__init__(view)
        self.view = view
        self.threads = {key: list(messages) for key, messages in THREADS.items()}
        self.selected_history = "start"
        self.state = "idle"
        self.settings = {(section.key, field.key): field.options[0]
                         for section in SECTIONS for field in section.fields}
        self.pending = False
        self.reply_timer = QTimer(self)
        self.reply_timer.setSingleShot(True)
        self.reply_timer.setInterval(max(1, min(reply_delay_ms, 5000)))
        self.reply_timer.timeout.connect(self.finish_reply)
        view.send_requested.connect(self.send)
        view.stop_requested.connect(self.stop)
        view.history_selected.connect(self.select_history)
        view.today_selected.connect(self.select_today)
        view.setting_changed.connect(self.change_setting)
        view.settings_reset_requested.connect(self.reset_settings)
        view.attachment_requested.connect(self.attach)
        view.demo_state_requested.connect(self.set_state)
        self.refresh()

    def refresh(self):
        self.view.set_messages(() if self.state == "empty" else self.threads[self.selected_history])
        self.refresh_history()
        self.view.set_today(() if self.state == "empty" else TODAY)
        self.view.set_settings(SECTIONS, self.settings)
        self.view.set_state(self.state)
        self.view.set_busy(self.pending)

    def refresh_history(self):
        entries = tuple(HistoryEntry(entry.key, entry.title,
                        entry.subtitle.split(" · ")[0] + f" · {len(self.threads[entry.key])} 則示範訊息")
                        for entry in HISTORY)
        self.view.set_history(entries, self.selected_history)

    def set_state(self, state: str):
        # Validate before mutating or cancelling any preview state.
        from kuro_launcher.qt_work_companion_view import STATE_LABELS
        if state not in STATE_LABELS:
            raise ValueError(f"Unknown preview state: {state}")
        if self.pending:
            self.stop()
        self.state = state
        self.view.close_drawer()
        self.refresh()

    def send(self, text: str):
        if self.pending or self.state in ("disabled", "loading") or not text.strip():
            return
        if self.state == "empty":
            self.selected_history = "blank"
        self.state = "idle"
        self.threads[self.selected_history].append(Message("YOU", "09:12", text.strip()))
        self.view.composer_edit.clear()
        self.pending = True
        self.view.set_state("idle")
        self.view.set_messages(self.threads[self.selected_history], follow_tail=True)
        self.refresh_history()
        self.view.set_busy(True)
        self.view.composer_notice.setText("SYNTHETIC · 正在示範回覆，可按「停止」。")
        self.reply_timer.start()

    def finish_reply(self):
        if not self.pending:
            return
        self.reply_timer.stop()
        self.pending = False
        self.threads[self.selected_history].append(Message(
            "KURO", "09:12", "這是一段固定的預覽回覆。\n已在本次畫面加入一個示範回合，沒有呼叫模型、執行指令或保存內容。"))
        self.view.set_messages(self.threads[self.selected_history], follow_tail=True)
        self.refresh_history()
        self.view.set_busy(False)
        self.view.composer_notice.setText("SYNTHETIC · 示範回覆完成，內容僅留在這次預覽。")

    def stop(self):
        if not self.pending:
            return
        self.reply_timer.stop()
        self.pending = False
        self.view.set_busy(False)
        self.view.composer_notice.setText("SYNTHETIC · 已停止示範回覆；剛才輸入的文字仍留在本頁。")

    def select_history(self, key: str):
        if key not in self.threads:
            raise ValueError(f"Unknown synthetic thread: {key}")
        self.stop()
        self.selected_history = key
        self.state = "idle"
        self.view.composer_edit.clear()
        self.refresh()
        self.view.composer_notice.setText("SYNTHETIC · 已切換匿名示範對話，不讀取正式紀錄。")

    def select_today(self, key: str):
        item = next((item for item in TODAY if item.key == key), None)
        if item is None:
            raise ValueError(f"Unknown synthetic Today item: {key}")
        self.view.show_today_detail(item)

    def change_setting(self, section: str, field: str, value: str):
        definition = next((entry for entry in SECTIONS if entry.key == section), None)
        option = next((entry for entry in definition.fields if entry.key == field), None) if definition else None
        if option is None or not option.enabled or value not in option.options:
            raise ValueError("Unknown or disabled synthetic setting")
        self.settings[section, field] = value

    def reset_settings(self, section: str):
        definition = next((entry for entry in SECTIONS if entry.key == section), None)
        if definition is None:
            raise ValueError(f"Unknown synthetic section: {section}")
        for field in definition.fields:
            self.settings[section, field.key] = field.options[0]
        self.view.set_settings(SECTIONS, self.settings)
        self.view.settings_note.setText("DEMO · 本頁示範值已還原；正式設定不受影響。")

    def attach(self):
        self.view.composer_notice.setText("SYNTHETIC · 示例附件：sample-note.txt（僅名稱，沒有讀取檔案）。")
