{
  "version": 1,
  "default_mode": "blocked",
  "tools": {
    "kuro-web::get_current_time": {
      "mode": "read_only",
      "category": "web"
    },
    "kuro-web::search_web": {
      "mode": "read_only",
      "category": "web"
    },
    "kuro-web::smart_search_web": {
      "mode": "read_only",
      "category": "web"
    },
    "kuro-web::advanced_search_web": {
      "mode": "read_only",
      "category": "web"
    },
    "kuro-web::fetch_content": {
      "mode": "read_only",
      "category": "web",
      "url_args": [
        "url"
      ],
      "block_private_urls": true
    },
    "kuro-filesystem::search_past_conversations": {
      "mode": "read_only",
      "category": "memory"
    },
    "kuro-mail::mail.auth_status": {
      "mode": "read_only",
      "category": "mail"
    },
    "kuro-mail::mail.auth_start": {
      "mode": "confirm",
      "category": "mail"
    },
    "kuro-mail::mail.auth_finish": {
      "mode": "confirm",
      "category": "mail"
    },
    "kuro-mail::mail.list_unread": {
      "mode": "read_only",
      "category": "mail",
      "deny_truthy_args": [
        "include_spam_trash"
      ]
    },
    "kuro-mail::mail.search_recent": {
      "mode": "read_only",
      "category": "mail",
      "deny_truthy_args": [
        "include_spam_trash"
      ]
    },
    "kuro-mail::mail.get_message_summary": {
      "mode": "read_only",
      "category": "mail"
    },
    "kuro-mail::mail.get_message_detail": {
      "mode": "read_only",
      "category": "mail"
    },
    "kuro-mail::mail.daily_brief": {
      "mode": "read_only",
      "category": "mail",
      "deny_truthy_args": [
        "include_spam_trash"
      ]
    },
    "kuro-mail::mail.refresh": {
      "mode": "read_only",
      "category": "mail",
      "deny_truthy_args": [
        "include_spam_trash"
      ]
    },
    "memory-core::search": {
      "mode": "read_only",
      "category": "memory_core"
    },
    "memory-core::fetch": {
      "mode": "read_only",
      "category": "memory_core"
    },
    "memory-core::memory_fetch_record_revision": {
      "mode": "read_only",
      "category": "memory_core"
    },
    "memory-core::memory_list_record_links": {
      "mode": "read_only",
      "category": "memory_core"
    },
    "memory-core::memory_overview": {
      "mode": "read_only",
      "category": "memory_core"
    },
    "memory-core::memory_detect_duplicates": {
      "mode": "read_only",
      "category": "memory_core"
    },
    "memory-core::memory_list_collections": {
      "mode": "read_only",
      "category": "memory_core"
    },
    "memory-core::memory_get_collection": {
      "mode": "read_only",
      "category": "memory_core"
    },
    "personal-asset-os::get_asset_overview": {
      "mode": "read_only",
      "category": "personal_asset_os"
    },
    "personal-asset-os::list_asset_accounts": {
      "mode": "read_only",
      "category": "personal_asset_os"
    },
    "personal-asset-os::list_asset_positions": {
      "mode": "read_only",
      "category": "personal_asset_os"
    },
    "personal-asset-os::list_recent_asset_transactions": {
      "mode": "read_only",
      "category": "personal_asset_os"
    },
    "personal-asset-os::get_pending_financial_events": {
      "mode": "read_only",
      "category": "personal_asset_os"
    },
    "personal-asset-os::get_reconciliation_status": {
      "mode": "read_only",
      "category": "personal_asset_os"
    },
    "personal-asset-os::get_asset_system_status": {
      "mode": "read_only",
      "category": "personal_asset_os"
    }
  },
  "filesystem": {
    "deny_path_patterns": [
      "*.env",
      "*.env.*",
      "*/.env",
      "*/.env.*",
      "*.pem",
      "*.key",
      "*.pfx",
      "*.p12",
      "*id_rsa*",
      "*id_ed25519*",
      "*api_key*",
      "*apikey*",
      "*secret*",
      "*password*",
      "*credential*",
      "*/AppData/Local/Google/Chrome/User Data/*",
      "*/AppData/Local/Microsoft/Edge/User Data/*",
      "*/AppData/Roaming/Mozilla/Firefox/Profiles/*",
      "*/Cookies",
      "*/Login Data"
    ],
    "deny_path_parts": [
      ".git",
      ".ssh",
      ".gnupg",
      "keyrings"
    ]
  },
  "web": {
    "blocked_hostnames": [
      "localhost",
      "127.0.0.1",
      "::1",
      "0.0.0.0"
    ],
    "block_private_networks": true
  },
  "owner_services": [
    "project-workspace",
    "japanese-study",
    "english-study",
    "listening-audio",
    "omi-search"
  ]
}
